# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=raw-telemetry
KAFKA_CHANGELOG_TOPIC=changelog-topic
KAFKA_PROCESSED_TOPIC=processed-averages
KAFKA_ALERTS_TOPIC=alerts-topic
KAFKA_NUM_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# Stream Processing Engine Configuration
WINDOW_SIZE_SECONDS=300
WINDOW_SLIDE_SECONDS=10
GRACE_PERIOD_SECONDS=30
ROCKSDB_STATE_DIR=./data/rocksdb_state

# Anomaly Detection Thresholds (Cold-Chain Frozen Food)
SAFE_TEMP_MIN=-25.0
SAFE_TEMP_MAX=-10.0
TEMP_SPIKE_TOLERANCE=3.0

# Backend & Security
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=streamforge_super_secure_jwt_secret_key_2026_axlero_top_performer
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Webhook Alert Dispatcher
WEBHOOK_ALERT_URL=http://localhost:8000/api/v1/mock-webhook
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=5.0

# Simulation / Load Testing
SIMULATION_RATE_PER_SEC=100
SIMULATION_NUM_TRUCKS=500
SIMULATION_NUM_CUSTOMERS=5
